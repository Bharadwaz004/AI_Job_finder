# ──────────────────────────────────────────────
# AI Resume Job Finder — Environment Variables
# ──────────────────────────────────────────────

# LLM Provider: "huggingface" | "ollama"
LLM_PROVIDER=huggingface

# HuggingFace Inference Providers (free tier available)
# Get your token at: https://huggingface.co/settings/tokens
# IMPORTANT: Enable "Make calls to Inference Providers" permission on your token
HF_API_TOKEN=hf_your-token-here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Other strong options (all routed through free providers):
#   Qwen/Qwen2.5-72B-Instruct                  — best quality (via SambaNova)
#   meta-llama/Llama-3.3-70B-Instruct           — excellent (via Cerebras)
#   deepseek-ai/DeepSeek-V3-0324               — strong reasoning
#   mistralai/Mistral-Small-24B-Instruct-2501   — good balance
HF_API_URL=https://router.huggingface.co/v1

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Job Search (Adzuna — free tier)
# Register at: https://developer.adzuna.com/
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key
ADZUNA_COUNTRY=in
# Country codes: gb, us, de, fr, au, in, ca, nz, pl, br, at, za

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=resume_job_finder

# Redis (optional — falls back to in-memory cache)
REDIS_URL=redis://localhost:6379

# App
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
